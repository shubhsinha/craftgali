# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (Neon in development). The pooler endpoint is fine for the web app.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signing key for the session cookie. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Absolute origin used to build password-reset links. Falls back to VERCEL_URL,
# then to http://localhost:3000.
SITE_ORIGIN="http://localhost:3000"

# Transactional mail. Leave both blank in development: reset links are written
# to the server log instead of being sent.
RESEND_API_KEY=""
MAIL_FROM="CraftGali <no-reply@example.com>"
